{
  "name": "tapchi",
  "compatibility_date": "2026-11-17",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tapchi_db",
      "database_id": "THAY_BANG_DATABASE_ID_CUA_BAN"
    }
  ]
}
